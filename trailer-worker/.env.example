# Copy to .env (next to make_previews.py). Never commit .env.

# Bunny Storage (dashboard > Storage > your zone > FTP & API access: the zone password)
BUNNY_STORAGE_ZONE=
BUNNY_API_KEY=
BUNNY_STORAGE_HOST=ny.storage.bunnycdn.com
BUNNY_CDN_BASE=https://zuvo-movies-cdn.b-cdn.net

# The site's server, for run.sh (an SSH key, no password: see README.md)
SERVER_SSH=user@your-server
SERVER_DIR=/opt/taurus

# Optional
# MAX_MINUTES=480            # run.sh: stop after 8 h (the next night carries on)
# BLOCKED_PAUSE_MINUTES=30   # run.sh: YouTube refused: wait this long, then try again
# PROGRESS_MINUTES=60        # run.sh: give the site the clips made so far + progress for its dashboard
# DELAY_MIN=10               # seconds between titles: lower = faster, but YouTube blocks sooner
# DELAY_MAX=20
# PREVIEW_HEIGHT=540
# CLIP_SECONDS=15
# YTDLP_COOKIES_FILE=/home/you/youtube-cookies.txt   # only if YouTube keeps refusing

# TMDB (same key as backend/.env): the title's other trailers and names when the one asked for
# can't be used. Without it only a YouTube search is tried.
TMDB_API_KEY=
# MAX_VIDEOS_PER_TITLE=8     # videos looked at for one title, at most
# SEARCH_RESULTS=10          # YouTube search results read
# RECHECK_DAYS=60            # no video fitted: tried again after this many days
# TMP_BASE=/tmp
