# Variables for docker-compose.yml (copy to .env next to it; .env is not committed)

# MySQL root password, used only when the database volume is created for the first time.
# Same value as DB_PASSWORD in backend/.env.
MYSQL_ROOT_PASSWORD=

# The site's domain, without https:// or www. (docs/CONFIG.md: "Change the domain"). nginx, the
# frontend build, the backend's hosts / origins / links and scripts/heartbeat.sh all follow it.
SITE_DOMAIN=
