# Copy to .env (next to run.sh). Never commit .env.

# The site's server, for run.sh (an SSH key, no password: see README.md)
SERVER_SSH=user@your-server
SERVER_DIR=/opt/taurus

# Optional
# CONCURRENCY=4       # sites / providers checked in parallel
# MIN_SITES_OK=5      # fewer sites read than this: the scan isn't trusted, nothing is imported
