# Every setting, where it lives and how to change it: docs/CONFIG.md

# Django
DJANGO_SECRET_KEY=
# 0 in production (1 shows the site's code and settings on error pages)
DJANGO_DEBUG=0
# leave empty: follows SITE_DOMAIN (in /opt/taurus/.env) + localhost, 127.0.0.1, backend
DJANGO_ALLOWED_HOSTS=

# Admin “caché”
ADMINADMIN_URL=

# DB (MySQL)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Frontend / CORS / CSRF: leave these three empty, they follow SITE_DOMAIN (https://<domain>, www too).
# Set them only for a local run (e.g. http://localhost:3000).
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
CORS_ALLOW_CREDENTIALS=
CORS_ALLOW_ALL_ORIGINS=

# Email
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
TMDB_API_KEY=
# Claude API key (console.anthropic.com): AI title tags, manage.py tag_titles
ANTHROPIC_API_KEY=

# Optional
DEFAULT_FROM_EMAIL=
THROTTLE_AUTH_RATE=10/min
BUNNY_CDN_BASE=https://zuvo-movies-cdn.b-cdn.net
THROTTLE_PASSWORD_RESET_RATE=5/hour
THROTTLE_IMPORT_RATE=20/hour
NUM_PROXIES=1
SUPPORT_EMAIL=
PREMIUM_PRICE=9.99
PREMIUM_CURRENCY=USD

# healthchecks.io ping URLs (ops/README.md "Running without anyone"): kept out of git
HC_PING_SITE=
HC_PING_CHECKUP=
