#: .\users\templates\emails\new_episodes.txt:12
#: .\users\templates\emails\password_reset.txt:12
#, python-format
msgid "This email was sent by %(company)s. For help, contact"
msgstr "此邮件由 %(company)s 发送。如需帮助，请联系"

#: .\users\templates\emails\email_change.html:3
#: .\users\templates\emails\email_change.html:4 .\users\views.py:266
msgid "Confirm your new email address"
msgstr "确认你的新邮箱地址"

#: .\users\templates\emails\email_change.html:6
#, python-format
msgid ""
"We received a request to change your account email to <strong>%(new_email)s</"
"strong>. Click the button below to confirm:"
msgstr ""
"我们收到了将你的账户邮箱更改为 <strong>%(new_email)s</strong> 的请求。请点击"
"下方按钮确认："

#: .\users\templates\emails\email_change.html:7
msgid "Confirm email change"
msgstr "确认更改邮箱"

#: .\users\templates\emails\email_change.html:9
#: .\users\templates\emails\email_change.txt:9
msgid ""
"If you didn't ask for this, you can ignore this email: nothing will change."
msgstr "如果这不是你本人的操作，请忽略此邮件，任何内容都不会改变。"

#: .\users\templates\emails\email_change.txt:4
#, python-format
msgid "We received a request to change your account email to %(new_email)s."
msgstr "我们收到了将你的账户邮箱更改为 %(new_email)s 的请求。"

#: .\users\templates\emails\email_change.txt:5
msgid "Open this link to confirm:"
msgstr "打开此链接以确认："

#: .\users\templates\emails\new_episodes.html:3
#: .\users\templates\emails\new_episodes.html:4
msgid "New episodes are out"
msgstr "新剧集已上线"

#: .\users\templates\emails\new_episodes.html:6
#: .\users\templates\emails\new_episodes.txt:4
#, python-format
msgid "Shows you follow on %(company)s have new episodes:"
msgstr "你在 %(company)s 关注的剧集有新剧集："

#: .\users\templates\emails\new_episodes.html:12
#: .\users\templates\emails\new_episodes.txt:6
#, python-format
msgid "Season %(season)s, episode %(episode)s"
msgstr "第 %(season)s 季 第 %(episode)s 集"

#: .\users\templates\emails\new_episodes.html:16
msgid "Watch"
msgstr "观看"

#: .\users\templates\emails\new_episodes.html:22
#: .\users\templates\emails\new_episodes.txt:9
msgid ""
"You get this email because you clicked “Notify me” on these shows. Click it "
"again on a show's page to stop."
msgstr ""
"你收到此邮件是因为你在这些剧集上点击了“通知我”。在剧集页面再次点击即可停止。"

#: .\users\templates\emails\password_reset.html:3 .\users\views.py:440
msgid "Reset your password"
msgstr "重置密码"

#: .\users\templates\emails\password_reset.html:4
msgid "Password reset request"
msgstr "密码重置请求"

#: .\users\templates\emails\password_reset.html:6
#, python-format
msgid ""
"We received a request to reset the password for your %(company)s account. "
"Click the button below to choose a new one:"
msgstr ""
"我们收到了重置你的 %(company)s 账户密码的请求。请点击下方按钮设置新密码："

#: .\users\templates\emails\password_reset.html:7
msgid "Reset password"
msgstr "重置密码"

#: .\users\templates\emails\password_reset.html:9
#: .\users\templates\emails\password_reset.txt:9
msgid ""
"If you didn't ask for this, you can ignore this email: your account is safe."
msgstr "如果这不是你本人的操作，请忽略此邮件，你的账户是安全的。"

#: .\users\templates\emails\password_reset.txt:4
#, python-format
msgid ""
"We received a request to reset the password for your %(company)s account."
msgstr "我们收到了重置你的 %(company)s 账户密码的请求。"

#: .\users\templates\emails\password_reset.txt:5
msgid "Open this link to choose a new one:"
msgstr "打开此链接以设置新密码："

