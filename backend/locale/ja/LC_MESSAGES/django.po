#: .\reco\management\commands\notify_new_episodes.py:101
#, python-format
msgid "%(count)d new episode of shows you follow"
msgid_plural "%(count)d new episodes of shows you follow"
msgstr[0] "フォロー中のシリーズの新しいエピソード %(count)d件"

#: .\users\templates\emails\_button.html:11
msgid "If the button doesn't work, copy this link into your browser:"
msgstr "ボタンが機能しない場合は、このリンクをブラウザにコピーしてください："

#: .\users\templates\emails\base.html:20
#: .\users\templates\emails\email_change.txt:2
