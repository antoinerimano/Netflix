#: .\users\templates\emails\email_change.html:3
#: .\users\templates\emails\email_change.html:4 .\users\views.py:266
msgid "Confirm your new email address"
msgstr "Bestätige deine neue E-Mail-Adresse"

#: .\users\templates\emails\email_change.html:6
#, python-format
msgid ""
"We received a request to change your account email to <strong>%(new_email)s</"
"strong>. Click the button below to confirm:"
msgstr ""
"Wir haben eine Anfrage erhalten, die E-Mail-Adresse deines Kontos in "
"<strong>%(new_email)s</strong> zu ändern. Klicke zur Bestätigung auf die "
"Schaltfläche unten:"

#: .\users\templates\emails\email_change.html:7
msgid "Confirm email change"
msgstr "E-Mail-Änderung bestätigen"

#: .\users\templates\emails\email_change.html:9
#: .\users\templates\emails\email_change.txt:9
msgid ""
"If you didn't ask for this, you can ignore this email: nothing will change."
msgstr ""
"Falls du das nicht angefordert hast, ignoriere diese E-Mail einfach: Es "
"ändert sich nichts."

#: .\users\templates\emails\email_change.txt:4
#, python-format
msgid "We received a request to change your account email to %(new_email)s."
msgstr ""
"Wir haben eine Anfrage erhalten, die E-Mail-Adresse deines Kontos in "
"%(new_email)s zu ändern."

#: .\users\templates\emails\email_change.txt:5
msgid "Open this link to confirm:"
msgstr "Öffne diesen Link zur Bestätigung:"

#: .\users\templates\emails\new_episodes.html:3
