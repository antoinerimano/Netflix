# Edit this file to introduce tasks to be run by cron.
# 
# Each task to run has to be defined through a single line
# indicating with different fields when the task will be run
# and what command to run for the task
# 
# To define the time you can provide concrete values for
# minute (m), hour (h), day of month (dom), month (mon),
# and day of week (dow) or use '*' in these fields (for 'any').
# 
# Notice that tasks will be started based on the cron's system
# daemon's notion of time and timezones.
# 
# Output of the crontab jobs (including errors) is sent through
# email to the user the crontab file belongs to (unless redirected).
# 
# For example, you can run a backup of all your user accounts
# at 5 a.m every week with:
# 0 5 * * 1 tar -zcf /var/backups/home.tgz /home/
# 
# For more information see the manual pages of crontab(5) and cron(8)
# 
# m h  dom mon dow   command
# catalog cleanup (users/management/commands/clean_db.py): duplicate titles, then missing TMDB fields for the
# titles not read for 30 days (never read / most popular first), 150 min a night: the catalog once a month,
# and a run cut off carries on the next night
30 4 * * * cd /opt/taurus && /usr/bin/flock -n /tmp/clean_db_weekly.lock docker compose exec -T backend python manage.py clean_db --dedupe --backfill-tmdb --tv-sync-episodes --tv-max-seasons 2 --stale-days 30 --max-minutes 150 --check-dups --progress-every 500 >> /var/log/taurus_clean_db.log 2>&1
45 0 * * 0 cd /opt/taurus && /usr/bin/flock -n /tmp/sync_tmdb_weekly.lock docker compose exec -T backend python manage.py sync_tmdb_monthly --pages 20 --min-votes 500 --verbose-adds --only-created >> /var/log/sync_tmdb_weekly.log 2>&1
30 7 * * 0 cd /opt/taurus && /usr/bin/flock -n /tmp/taurus_heavy.lock docker compose exec -T backend python manage.py train_ranker >> /var/log/train_ranker_weekly.log 2>&1
# movies just released (users/management/commands/sync_tmdb_new_releases.py): trending today, in theatres, new on
# streaming, 50+ votes; before the nightly jobs that complete a new title (ratings, translations, related, index, embeddings)
30 0 * * * cd /opt/taurus && /usr/bin/flock -n /tmp/taurus_new_releases.lock docker compose exec -T backend python manage.py sync_tmdb_new_releases >> /var/log/taurus_new_releases.log 2>&1
# search / reco index tables (users/management/commands/rebuild_title_indexes.py): titles not indexed yet + the ones
# clean_db just read; after clean_db's 150 min
15 7 * * * cd /opt/taurus && /usr/bin/flock -n /tmp/taurus_index.lock docker compose exec -T backend python manage.py rebuild_title_indexes >> /var/log/taurus_index.log 2>&1
# embeddings + "more like this" for the titles that have none yet (new titles); Sunday's full build_embeddings redoes all
0 8 * * * cd /opt/taurus && /usr/bin/flock -n /tmp/taurus_heavy.lock docker compose exec -T backend python manage.py build_embeddings --missing >> /var/log/build_embeddings_nightly.log 2>&1
# weekly backup restore test (scripts/test_backup_restore.sh): the newest dump loaded into a throwaway MySQL, rows counted
15 2 * * 3 /usr/bin/flock -n /tmp/taurus_restore_test.lock /opt/taurus/scripts/test_backup_restore.sh >> /var/log/taurus_restore_test.log 2>&1
# TMDB recommendations / similar + alternative titles (users/tmdb_related.py): 5,000 titles a night, free
0 3 * * * cd /opt/taurus && /usr/bin/flock -n /tmp/taurus_related.lock docker compose exec -T backend python manage.py sync_tmdb_related >> /var/log/taurus_related.log 2>&1
# Top 10 home rows (users/management/commands/sync_tmdb_charts.py): TMDB trending movies today / shows this week, free
15 */6 * * * cd /opt/taurus && /usr/bin/flock -n /tmp/taurus_charts.lock docker compose exec -T backend python manage.py sync_tmdb_charts >> /var/log/taurus_charts.log 2>&1
# streaming services per country (users/watch_services.py): "On Netflix" rows, browse filter; 6,000 titles a night, free
30 5 * * * cd /opt/taurus && /usr/bin/flock -n /tmp/taurus_watch_providers.lock docker compose exec -T backend python manage.py sync_tmdb_watch_providers >> /var/log/taurus_watch_providers.log 2>&1
# daily check-up (users/checkup.py): emails staff only when a job / the disk / the AI budget has a problem
0 7 * * * cd /opt/taurus && /usr/bin/flock -n /tmp/taurus_checkup.lock docker compose exec -T backend python manage.py daily_checkup >> /var/log/taurus_checkup.log 2>&1 && scripts/hc_ping.sh HC_PING_CHECKUP
# age ratings from TMDB for titles never asked (users/maturity.py: what Kids / age-limited profiles may see), free
0 2 * * * cd /opt/taurus && /usr/bin/flock -n /tmp/taurus_ratings.lock docker compose exec -T backend python manage.py backfill_ratings --limit 20000 >> /var/log/taurus_ratings.log 2>&1
# overviews TMDB lacks in the languages profiles use, translated by Claude (users/ai_translate.py), within the AI budget
30 3 * * * cd /opt/taurus && /usr/bin/flock -n /tmp/taurus_translate.lock docker compose exec -T backend python manage.py translate_titles >> /var/log/taurus_translate.log 2>&1
# AI title tags: collect last night's Claude batch, send the next one (half price, done within 24 h)
0 4 * * * cd /opt/taurus && /usr/bin/flock -n /tmp/taurus_tags.lock docker compose exec -T backend python manage.py tag_titles >> /var/log/taurus_tags.log 2>&1
30 9 * * 0 cd /opt/taurus && /usr/bin/flock -n /tmp/taurus_heavy.lock docker compose exec -T backend python manage.py build_embeddings --type all --topk 80 --model-name all-MiniLM-L6-v2 >> /var/log/build_embeddings_weekly.log 2>&1
30 2 1 * * cd /opt/taurus && /usr/bin/flock -n /tmp/taurus_heavy.lock docker compose exec -T backend python manage.py fix_actor_duplicates >> /var/log/fix_actor_duplicates.log 2>&1
0 3 * * 0 /usr/local/bin/weekly-cleanup.sh
# --- updated 2026-11-06 (deploy dfb7c04, schedule from commands.txt) ---
*/15 * * * * /opt/taurus/scripts/cron_check_providers.sh >> /var/log/taurus_providers.log 2>&1
0 */3 * * * /usr/bin/flock -n /tmp/taurus_episodes.lock /opt/taurus/scripts/cron_sync_episodes.sh >> /var/log/taurus_episodes.log 2>&1
0 */2 * * * /usr/bin/flock -n /tmp/taurus_home.lock /opt/taurus/scripts/cron_build_home.sh >> /var/log/taurus_home.log 2>&1
# certbot: weekly (no-op unless <30 days left) so a missed monthly run can't let the cert expire
0 2 * * 1 cd /opt/taurus && docker compose run --rm certbot renew >> /var/log/certbot-renew.log 2>&1 && docker compose exec -T nginx nginx -s reload >> /var/log/certbot-renew.log 2>&1
# nightly DB backup -> /var/backups/taurus + Google Drive (scripts/backup_db.sh)
30 1 * * * /usr/bin/flock -n /tmp/taurus_backup.lock /opt/taurus/scripts/backup_db.sh >> /var/log/taurus_backup.log 2>&1
# healthchecks.io (scripts/hc_ping.sh, ping URLs in backend/.env): the site answers, every 5 min; the
# daily check-up above pings when it ran. A dead server sends nothing: healthchecks.io emails.
*/5 * * * * /opt/taurus/scripts/heartbeat.sh >> /var/log/taurus_heartbeat.log 2>&1
# a reboot when security updates need one (scripts/reboot_if_needed.sh), after the running job
30 10 * * 1 /opt/taurus/scripts/reboot_if_needed.sh >> /var/log/taurus_reboot.log 2>&1
